// ====================
// 商品相关模型
// ====================

model Commodity {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Float?
  spaceId     String
  space       Space    @relation(fields: [spaceId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
